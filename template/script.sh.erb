#!/usr/bin/env bash
# ============================================================
# llama.cpp Web UI - OpenOnDemand job script
#
# Architecture:
#
#   Browser -> OOD -> :$port (python proxy) -> 127.0.0.1:$LLAMA_PORT
#                                                   (llama-server in apptainer)
#
# Both $port (the OOD routing port) and $LLAMA_PORT (the internal
# inference port) are picked at random by find_port in before.sh.
#
# The llama server runs inside the llama.cpp Apptainer container on a
# GPU. The proxy starts immediately and shows a "model loading" page
# until the server is up, so the session can connect right away.
# ============================================================

set -u

<% require 'base64' -%>
LLAMA_SIF="<%= context.sif_path %>"
LLAMA_SIF="${LLAMA_SIF/#\~/$HOME}"
MODEL_PATH="<%= context.model_path %>"
MODEL_PATH="${MODEL_PATH/#\~/$HOME}"
TEMPERATURE="<%= context.enable_advanced_args == "0" ? "0.8" : context.temperature %>"
# API key is base64-encoded in the ERB template so that shell
# special characters ($, backticks, quotes, ...) in the key can
# never corrupt it in the rendered script.
API_KEY_B64="<%= Base64.strict_encode64(context.api_key.to_s) %>"
API_KEY="$(printf '%s' "$API_KEY_B64" | base64 -d 2>/dev/null)"
EXTRA_ARGS="<%= context.enable_advanced_args == "0" ? "" : context.extra_llama_args %>"
STORAGE_YOLO="<%= context.storage_yolo %>"
STORAGE_HOME_MOUNT="<%= context.storage_home_mount %>"
MOUNT1_SOURCE="<%= context.mount1_source %>"
MOUNT1_DEST="<%= context.mount1_dest %>"
MOUNT1_WRITABLE="<%= context.mount1_writable %>"
MOUNT2_SOURCE="<%= context.mount2_source %>"
MOUNT2_DEST="<%= context.mount2_dest %>"
MOUNT2_WRITABLE="<%= context.mount2_writable %>"
MOUNT3_SOURCE="<%= context.mount3_source %>"
MOUNT3_DEST="<%= context.mount3_dest %>"
MOUNT3_WRITABLE="<%= context.mount3_writable %>"
PROXY_PY="${LLAMA_PROXY_PY:-proxy.py}"

JOB_ID="${SLURM_JOB_ID:-$$}"
LOGDIR="${TMPDIR:-/tmp}/llama-webui-$JOB_ID"
mkdir -p "$LOGDIR"

# ── Internal inference port (random, chosen by find_port in
#    before.sh; fall back to a scan if it was lost or taken) ──────
port_in_use() {
    (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null
}
LLAMA_PORT="${llama_port:-}"
if [ -z "$LLAMA_PORT" ] || port_in_use "$LLAMA_PORT"; then
    LLAMA_PORT=$(find_port 2>/dev/null || true)
fi
if [ -z "$LLAMA_PORT" ] || port_in_use "$LLAMA_PORT"; then
    for p in $(seq 15000 15099); do
        if ! port_in_use "$p"; then
            LLAMA_PORT="$p"
            break
        fi
    done
fi
exec 3>&- 2>/dev/null || true

# ── CPU threads from the Slurm allocation ───────────────────────
THREADS="${SLURM_CPUS_PER_TASK:-$(nproc)}"

# ── Build the llama server command line ─────────────────────────
# Agent tools are always enabled.
TOOLS_ARGS=(--tools all)

# Multimodal projector for vision-capable models (gemma).
MMPROJ_ARGS=()
case "$MODEL_PATH" in
    /gpfs/models/gemma-4-31B-it-GGUF/*)
        MMPROJ_ARGS=(--mmproj /gpfs/models/gemma-4-31B-it-GGUF/mmproj-BF16.gguf)
        ;;
esac

API_ARGS=()
[ -n "$API_KEY" ] && API_ARGS=(--api-key "$API_KEY")

EXTRA_ARGS_ARR=()
read -r -a EXTRA_ARGS_ARR <<< "$EXTRA_ARGS"

# Apptainer arguments
APPTAINER_ARGS=(--nv)
# NOTE: --network none is intentionally not used here.
# With --network none the container gets an isolated network namespace,
# so the host-side Python proxy can no longer reach the llama-server
# listening on 127.0.0.1 inside the container. Network-level isolation
# is therefore replaced by llama.cpp's --offline flag, which prevents
# the server from making outbound requests while keeping loopback
# connectivity for the proxy.
# if [ "$NETWORK_OFFLINE" = "1" ]; then
#     APPTAINER_ARGS+=(--network none)
# fi

# Secure non-YOLO mode: explicitly avoid implicit /gpfs mounts
if [ "$STORAGE_YOLO" != "1" ]; then
    APPTAINER_ARGS+=(--no-mount /gpfs)
fi

# Apptainer bind mounts: model directory + mmproj, plus selective mounts when YOLO is off
BIND_ARGS=()
# Always ensure the models directory is available read-only inside the container.
# This is a minimum mount for the app to function in secure / non-YOLO mode.
# It is redundant in YOLO mode but harmless.
BIND_ARGS+=(--mount type=bind,src=/gpfs/models,dst=/models,ro)
if [ "$STORAGE_YOLO" = "1" ]; then
    # YOLO mode: bind model dir and mmproj as before, read-only
    BIND_ARGS+=(--mount type=bind,src="$(dirname "$MODEL_PATH")",dst="$(dirname "$MODEL_PATH")",ro)
    if [ ${#MMPROJ_ARGS[@]} -gt 0 ]; then
        BIND_ARGS+=(--mount type=bind,src="$(dirname "${MMPROJ_ARGS[1]}")",dst="$(dirname "${MMPROJ_ARGS[1]}")",ro)
    fi
else
    # Selective mounts
    # Model directory must still be accessible, read-only
    BIND_ARGS+=(--mount type=bind,src="$(dirname "$MODEL_PATH")",dst="$(dirname "$MODEL_PATH")",ro)
    if [ ${#MMPROJ_ARGS[@]} -gt 0 ]; then
        BIND_ARGS+=(--mount type=bind,src="$(dirname "${MMPROJ_ARGS[1]}")",dst="$(dirname "${MMPROJ_ARGS[1]}")",ro)
    fi
    # Home mount
    if [ "$STORAGE_HOME_MOUNT" = "1" ]; then
        BIND_ARGS+=(--mount type=bind,src="/gpfs/home/$USER",dst="/home/$USER")
    fi
    # Helper to add selective mounts
    add_mount() {
        local src="$1" dest="$2" writable="$3"
        [ -z "$src" ] && return
        [ -z "$dest" ] && dest="$src"
        if [ "$writable" = "1" ]; then
            BIND_ARGS+=(--mount type=bind,src="$src",dst="$dest")
        else
            BIND_ARGS+=(--mount type=bind,src="$src",dst="$dest",ro)
        fi
    }
    add_mount "$MOUNT1_SOURCE" "$MOUNT1_DEST" "$MOUNT1_WRITABLE"
    add_mount "$MOUNT2_SOURCE" "$MOUNT2_DEST" "$MOUNT2_WRITABLE"
    add_mount "$MOUNT3_SOURCE" "$MOUNT3_DEST" "$MOUNT3_WRITABLE"
fi

echo "========================================================"
echo "  llama.cpp Web UI"
echo "========================================================"
echo "  SIF:          $LLAMA_SIF"
echo "  Model:        $MODEL_PATH"
echo "  Inference:    127.0.0.1:$LLAMA_PORT"
echo "  OOD port:     $port"
echo "  OOD path:     /rnode/$(hostname)/$port/"
echo "  Slurm alloc:  partition=${SLURM_JOB_PARTITION:-?} qos=${SLURM_QOS:-?} nodes=${SLURM_JOB_NUM_NODES:-?} cpus-per-task=${SLURM_CPUS_PER_TASK:-?} total-cpus=${SLURM_NPROCS:-?} mem-per-node=${SLURM_MEM_PER_NODE:-?}K"
echo "  Threads:      $THREADS"
echo "  Temperature:  $TEMPERATURE"
echo "  API key:      $([ -n "$API_KEY" ] && echo "configured (${#API_KEY} chars)" || echo none)"
echo "  Tools:        enabled"
echo "  Extra args:   $EXTRA_ARGS"
echo "========================================================"

# ── Launch the llama server in the background ───────────────────
echo "Starting llama server in apptainer container..."
nohup apptainer run "${APPTAINER_ARGS[@]}" \
    "${BIND_ARGS[@]}" \
    "$LLAMA_SIF" \
    serve \
    -m "$MODEL_PATH" \
    --host 127.0.0.1 \
    --port "$LLAMA_PORT" \
    --threads "$THREADS" \
    --ctx-size 0 \
    --temp "$TEMPERATURE" \
    ${TOOLS_ARGS[@]+"${TOOLS_ARGS[@]}"} \
    ${MMPROJ_ARGS[@]+"${MMPROJ_ARGS[@]}"} \
    ${API_ARGS[@]+"${API_ARGS[@]}"} \
    ${EXTRA_ARGS_ARR[@]+"${EXTRA_ARGS_ARR[@]}"} \
    > "$LOGDIR/llama-server.log" 2>&1 &
LLAMA_PID=$!
echo "llama server pid: $LLAMA_PID (log: $LOGDIR/llama-server.log)"

# ── Start the reverse proxy (immediately; shows a loading page
#    until the server is up, so the browser can connect now) ────
echo "Starting proxy on port $port..."
PORT="$port" \
PATCH_BASE="/rnode/$(hostname)/$port" \
UPSTREAM_HOST="127.0.0.1" \
UPSTREAM_PORT="$LLAMA_PORT" \
PROXY_DEBUG="${PROXY_DEBUG:-0}" \
python3 "$PROXY_PY" > "$LOGDIR/proxy.log" 2>&1 &
PROXY_PID=$!

# ── Watchdog: if the server dies, show why and stop the job ────
(
    while kill -0 "$LLAMA_PID" 2>/dev/null; do
        sleep 5
    done
    echo "ERROR: llama server (pid $LLAMA_PID) exited. Last 30 log lines:"
    tail -n 30 "$LOGDIR/llama-server.log" 2>/dev/null
    kill "$PROXY_PID" 2>/dev/null
) &
WATCHDOG_PID=$!

# Wait for the proxy; when it goes away the job ends.
# Ensure a SIGTERM (session teardown) tears the server down with us.
# Kill the whole process group to ensure apptainer + llama-server children are reaped.
on_term() {
    echo "TERM received, shutting down..."
    kill "$PROXY_PID" "$WATCHDOG_PID" "$LLAMA_PID" 2>/dev/null
    # Give children a moment to exit gracefully
    sleep 2
    # Kill any remaining children in this process group
    pkill -TERM -P $$ 2>/dev/null || true
    kill -TERM 0 2>/dev/null || true
    exit 143
}
trap on_term TERM

wait "$PROXY_PID"
RC=$?

# ── Cleanup ─────────────────────────────────────────────────────
kill "$WATCHDOG_PID" 2>/dev/null
kill "$LLAMA_PID" 2>/dev/null
pkill -TERM -P "$LLAMA_PID" 2>/dev/null
sleep 2
pkill -KILL -P "$LLAMA_PID" 2>/dev/null 2>&1 || true
echo "Job finished (proxy exit code $RC). Logs: $LOGDIR/"
exit "$RC"
